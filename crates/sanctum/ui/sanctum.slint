import { LineEdit, ListView, ScrollView } from "std-widgets.slint";

export struct GameItem {
    id: string,
    title: string,
    path: string,
    cover: image,
    has-cover: bool,
    favorite: bool,
    missing: bool,
}

export struct ChoiceItem {
    path: string,
}

export struct MenuItem {
    label: string,
    command: string,
    enabled: bool,
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <length> button-height: 38px;
    callback clicked;
    height: button-height;
    min-width: 72px;
    border-radius: 9px;
    background: !root.enabled ? #172432 : touch.pressed ? (root.primary ? #35b6c7 : #33475a) : touch.has-hover ? (root.primary ? #25a8bb : #283b4e) : (root.primary ? #168fa4 : #203244);
    border-width: root.primary ? 0px : 1px;
    border-color: #385065;
    Text {
        text: root.text;
        color: root.enabled ? #f1f7fa : #627282;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component IconButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: touch.pressed ? #385064 : touch.has-hover ? #2a4053 : root.active ? #153e4b : transparent;
    Text {
        text: root.text;
        color: root.active ? #67e8f9 : #c5d1da;
        font-size: 19px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    min-width: 72px;
    border-radius: 17px;
    background: !root.enabled ? transparent : root.active ? #174d59 : touch.has-hover ? #1c3040 : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: #2e8797;
    Text {
        text: root.text;
        color: !root.enabled ? #506170 : root.active ? #76e9f7 : #8fa2b2;
        font-size: 13px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component SectionTitle inherits Text {
    color: #eaf2f7;
    font-size: 21px;
    font-weight: 700;
    vertical-alignment: center;
}

component GameSurface inherits Rectangle {
    in property <image> frame;
    in property <bool> frame-ready: false;
    in property <bool> fit-scaling: false;
    in property <int> frame-width: 640;
    in property <int> frame-height: 480;
    in property <string> status;
    property <float> available-scale: Math.min(self.width / (root.frame-width * 1px), self.height / (root.frame-height * 1px));
    property <float> draw-scale: root.fit-scaling ? root.available-scale : Math.max(1, Math.floor(root.available-scale));
    callback game-key(string, bool, bool, bool);
    background: #02070b;
    border-radius: 10px;
    clip: true;
    forward-focus: game-focus;

    if root.frame-ready : Image {
        source: root.frame;
        image-fit: fill;
        image-rendering: pixelated;
        width: root.frame-width * 1px * root.draw-scale;
        height: root.frame-height * 1px * root.draw-scale;
    }
    if !root.frame-ready : VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text {
            text: "SANCTUM";
            color: #31bfd1;
            font-size: 25px;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            text: root.status;
            color: #758998;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
    game-focus := FocusScope {
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            root.game-key(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
            accept
        }
    }
}

export component MainWindow inherits Window {
    title: "Sanctum";
    width: 1180px;
    height: 780px;
    background: #07111a;

    in property <[GameItem]> games;
    in property <[ChoiceItem]> entry-choices;
    in property <[MenuItem]> menu-items;
    in property <image> game-frame;
    in property <bool> frame-ready: false;
    in property <int> frame-width: 640;
    in property <int> frame-height: 480;
    in property <bool> running: false;
    in property <bool> detached: false;
    in property <bool> muted: false;
    in property <bool> fullscreen: false;
    in property <bool> log-open: false;
    in property <bool> settings-open: false;
    in property <bool> details-open: false;
    in property <bool> choices-open: false;
    in property <bool> storage-confirm-open: false;
    in property <int> filter-index: 0;
    in property <int> sort-index: 0;
    in property <string> status: "Ready";
    in property <string> program-log;
    in property <string> selected-title;
    in property <string> selected-path;
    in property <bool> selected-favorite: false;
    in property <string> data-path;
    in property <string> templeos-path;
    in property <string> storage-label;
    in property <string> storage-action;
    in property <bool> portable-available: true;
    in property <bool> fit-scaling: false;

    callback add-file;
    callback add-folder;
    callback search-changed(string);
    callback set-filter(int);
    callback set-sort(int);
    callback select-game(string);
    callback run-game(string);
    callback toggle-favorite(string);
    callback close-details;
    callback save-title(string);
    callback toggle-selected-favorite;
    callback choose-entrypoint;
    callback choose-cover;
    callback remove-selected;
    callback run-selected;
    callback choose-entry(string);
    callback cancel-choices;
    callback show-settings;
    callback close-settings;
    callback choose-templeos;
    callback set-scaling(bool);
    callback request-storage-change;
    callback cancel-storage-change;
    callback confirm-storage-change;
    callback show-library;
    callback stop-runner;
    callback restart-runner;
    callback toggle-mute;
    callback toggle-fullscreen;
    callback toggle-detached;
    callback toggle-log;
    callback invoke-menu(string);
    callback game-key(string, bool, bool, bool);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 64px;
            background: #0b1925;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 18px;
                spacing: 12px;
                alignment: center;
                Text { text: "✥"; color: #56ddea; font-size: 25px; vertical-alignment: center; }
                Text { text: "SANCTUM"; color: #f0f6f9; font-size: 19px; font-weight: 800; letter-spacing: 1.4px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                if root.running : Text { text: root.status; color: #8ea2b1; font-size: 13px; vertical-alignment: center; }
                IconButton { text: "⚙"; clicked => { root.show-settings(); } }
            }
        }

        if !root.running : HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 210px;
                background: #09151f;
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text { text: "LIBRARY"; color: #647b8d; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; }
                    PillButton { text: "All programs"; active: root.filter-index == 0; clicked => { root.set-filter(0); } }
                    PillButton { text: "Favorites"; active: root.filter-index == 1; clicked => { root.set-filter(1); } }
                    PillButton { text: "Recent"; active: root.filter-index == 2; clicked => { root.set-filter(2); } }
                    Rectangle { height: 12px; background: transparent; }
                    Text { text: "SORT"; color: #647b8d; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; }
                    PillButton { text: "Title"; active: root.sort-index == 0; clicked => { root.set-sort(0); } }
                    PillButton { text: "Last played"; active: root.sort-index == 1; clicked => { root.set-sort(1); } }
                    PillButton { text: "Date added"; active: root.sort-index == 2; clicked => { root.set-sort(2); } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { text: root.status; color: #718697; font-size: 12px; wrap: word-wrap; }
                }
            }
            Rectangle {
                background: #07111a;
                VerticalLayout {
                    padding: 26px;
                    spacing: 18px;
                    HorizontalLayout {
                        height: 42px;
                        spacing: 10px;
                        SectionTitle { text: "Your programs"; horizontal-stretch: 1; }
                        LineEdit {
                            width: 260px;
                            placeholder-text: "Search library";
                            input-type: search;
                            edited(value) => { root.search-changed(value); }
                        }
                        ActionButton { text: "Add .HC"; clicked => { root.add-file(); } }
                        ActionButton { text: "Add folder"; primary: true; clicked => { root.add-folder(); } }
                    }
                    if root.games.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        border-radius: 14px;
                        background: #0b1924;
                        border-width: 1px;
                        border-color: #162b3b;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            Text { text: "No HolyC programs here yet"; color: #d9e7ee; font-size: 20px; horizontal-alignment: center; }
                            Text { text: "Add a .HC file or select a project folder to begin."; color: #718697; font-size: 14px; horizontal-alignment: center; }
                            ActionButton { text: "Add your first program"; primary: true; clicked => { root.add-file(); } }
                        }
                    }
                    if root.games.length > 0 : ListView {
                        vertical-stretch: 1;
                        for game[index] in root.games : Rectangle {
                            width: parent.width;
                            height: 126px;
                            border-radius: 13px;
                            background: card-touch.has-hover ? #102333 : #0c1b27;
                            border-width: 1px;
                            border-color: game.missing ? #78434c : #193143;
                            card-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-game(game.id); } }
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 16px;
                                Rectangle {
                                    width: 136px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: #102b38;
                                    if game.has-cover : Image { source: game.cover; image-fit: cover; image-rendering: pixelated; }
                                    if !game.has-cover : Text { text: "HOLY\nC"; color: #46cfda; font-size: 22px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout {
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 5px;
                                    Text { text: game.title; color: #edf5f8; font-size: 18px; font-weight: 700; overflow: elide; }
                                    Text { text: game.path; color: #718697; font-size: 12px; overflow: elide; }
                                    Text { text: game.missing ? "Entrypoint missing" : "Ready to run"; color: game.missing ? #f49aa7 : #58c995; font-size: 12px; }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                IconButton { text: game.favorite ? "★" : "☆"; active: game.favorite; clicked => { root.toggle-favorite(game.id); } }
                                ActionButton { text: "Details"; clicked => { root.select-game(game.id); } }
                                ActionButton { text: "Run"; primary: true; enabled: !game.missing; clicked => { root.run-game(game.id); } }
                            }
                        }
                    }
                }
            }
        }

        if root.running : VerticalLayout {
            padding: 14px;
            spacing: 10px;
            Rectangle {
                height: 48px;
                border-radius: 11px;
                background: #0c1b27;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;
                    ActionButton { text: "Library"; clicked => { root.show-library(); } }
                    ActionButton { text: "Stop"; clicked => { root.stop-runner(); } }
                    ActionButton { text: "Restart"; clicked => { root.restart-runner(); } }
                    Rectangle { width: 1px; height: 24px; background: #284052; }
                    IconButton { text: root.muted ? "🔇" : "🔊"; active: root.muted; clicked => { root.toggle-mute(); } }
                    ActionButton { text: root.fullscreen ? "Windowed" : "Fullscreen"; clicked => { root.toggle-fullscreen(); } }
                    ActionButton { text: root.detached ? "Dock game" : "Pop out"; primary: root.detached; clicked => { root.toggle-detached(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.status; color: #8ca0b0; font-size: 13px; vertical-alignment: center; }
                    IconButton { text: "≡"; active: root.log-open; clicked => { root.toggle-log(); } }
                }
            }
            if root.menu-items.length > 0 : Rectangle {
                height: 36px;
                background: transparent;
                HorizontalLayout {
                    spacing: 7px;
                    for menu in root.menu-items : PillButton {
                        text: menu.label;
                        active: false;
                        enabled: menu.enabled;
                        clicked => { root.invoke-menu(menu.command); }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
            }
            if !root.detached : GameSurface {
                vertical-stretch: 1;
                frame: root.game-frame;
                frame-ready: root.frame-ready;
                fit-scaling: root.fit-scaling;
                frame-width: root.frame-width;
                frame-height: root.frame-height;
                status: root.status;
                game-key(text, shift, control, alt) => { root.game-key(text, shift, control, alt); }
            }
            if root.detached : Rectangle {
                vertical-stretch: 1;
                border-radius: 12px;
                background: #091721;
                border-width: 1px;
                border-color: #173247;
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text { text: "Game opened in a separate window"; color: #dbe8ee; font-size: 19px; horizontal-alignment: center; }
                    Text { text: "The same runner, input, audio, and save state remain active."; color: #718697; font-size: 13px; horizontal-alignment: center; }
                    ActionButton { text: "Dock game here"; primary: true; clicked => { root.toggle-detached(); } }
                }
            }
            if root.log-open : Rectangle {
                height: 150px;
                border-radius: 10px;
                background: #050c12;
                border-width: 1px;
                border-color: #193143;
                ScrollView {
                    Text {
                        width: parent.width;
                        text: root.program-log;
                        color: #9fb2bf;
                        font-family: "monospace";
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    if root.details-open : Rectangle {
        background: #00000099;
        TouchArea { }
        Rectangle {
            width: 520px;
            height: 390px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: #0d1d29;
            border-width: 1px;
            border-color: #244156;
            VerticalLayout {
                padding: 24px;
                spacing: 13px;
                HorizontalLayout {
                    SectionTitle { text: "Program details"; horizontal-stretch: 1; }
                    IconButton { text: "×"; clicked => { root.close-details(); } }
                }
                Text { text: "TITLE"; color: #6f8798; font-size: 11px; font-weight: 700; }
                LineEdit { text: root.selected-title; edited(value) => { root.save-title(value); } }
                Text { text: "ENTRYPOINT"; color: #6f8798; font-size: 11px; font-weight: 700; }
                Text { text: root.selected-path; color: #b8c8d2; font-size: 12px; overflow: elide; }
                HorizontalLayout {
                    spacing: 8px;
                    ActionButton { text: root.selected-favorite ? "★ Favorite" : "☆ Favorite"; clicked => { root.toggle-selected-favorite(); } }
                    ActionButton { text: "Entrypoint"; clicked => { root.choose-entrypoint(); } }
                    ActionButton { text: "Cover"; clicked => { root.choose-cover(); } }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 8px;
                    ActionButton { text: "Remove"; clicked => { root.remove-selected(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { text: "Run program"; primary: true; clicked => { root.run-selected(); } }
                }
            }
        }
    }

    if root.settings-open : Rectangle {
        background: #00000099;
        TouchArea { }
        Rectangle {
            width: 600px;
            height: 470px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: #0d1d29;
            border-width: 1px;
            border-color: #244156;
            VerticalLayout {
                padding: 24px;
                spacing: 13px;
                HorizontalLayout {
                    SectionTitle { text: "Settings"; horizontal-stretch: 1; }
                    IconButton { text: "×"; clicked => { root.close-settings(); } }
                }
                Text { text: "TEMPLEOS FILES"; color: #6f8798; font-size: 11px; font-weight: 700; }
                Text { text: root.templeos-path; color: #b8c8d2; font-size: 12px; overflow: elide; }
                ActionButton { text: "Choose extracted TempleOS folder"; clicked => { root.choose-templeos(); } }
                Text { text: "CANVAS SCALING"; color: #6f8798; font-size: 11px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 8px;
                    PillButton { text: "Sharp pixels"; active: !root.fit-scaling; clicked => { root.set-scaling(false); } }
                    PillButton { text: "Fit window"; active: root.fit-scaling; clicked => { root.set-scaling(true); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                Text { text: "STORAGE"; color: #6f8798; font-size: 11px; font-weight: 700; }
                Text { text: root.storage-label + "  •  " + root.data-path; color: #b8c8d2; font-size: 12px; overflow: elide; }
                ActionButton { text: root.storage-action; enabled: root.portable-available; clicked => { root.request-storage-change(); } }
                if !root.portable-available : Text { text: "Portable mode is unavailable because the executable folder is not writable."; color: #e6a269; font-size: 12px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: "Imported HolyC projects always remain in their original folders."; color: #62798a; font-size: 12px; }
            }
        }
    }

    if root.choices-open : Rectangle {
        background: #000000aa;
        TouchArea { }
        Rectangle {
            width: 560px;
            height: 480px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: #0d1d29;
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    SectionTitle { text: "Choose an entrypoint"; horizontal-stretch: 1; }
                    IconButton { text: "×"; clicked => { root.cancel-choices(); } }
                }
                Text { text: "Select the .HC file Sanctum should launch for this folder."; color: #7890a0; font-size: 13px; }
                ListView {
                    vertical-stretch: 1;
                    for choice in root.entry-choices : ActionButton {
                        width: parent.width;
                        text: choice.path;
                        clicked => { root.choose-entry(choice.path); }
                    }
                }
            }
        }
    }

    if root.storage-confirm-open : Rectangle {
        background: #000000bb;
        TouchArea { }
        Rectangle {
            width: 510px;
            height: 245px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: #0d1d29;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                SectionTitle { text: "Move Sanctum data?"; }
                Text { text: "Settings, covers, and compatibility save data will be staged, verified, and moved. Your imported HolyC projects and TempleOS folder stay where they are."; color: #aabdc8; font-size: 13px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { text: "Cancel"; clicked => { root.cancel-storage-change(); } }
                    ActionButton { text: "Move and restart"; primary: true; clicked => { root.confirm-storage-change(); } }
                }
            }
        }
    }
}

export component GameWindow inherits Window {
    title: "Sanctum — Game";
    width: 960px;
    height: 720px;
    background: #050c12;
    in property <image> game-frame;
    in property <bool> frame-ready: false;
    in property <bool> fit-scaling: false;
    in property <int> frame-width: 640;
    in property <int> frame-height: 480;
    in property <bool> muted: false;
    in property <bool> fullscreen: false;
    in property <string> status;
    callback dock;
    callback stop-runner;
    callback restart-runner;
    callback toggle-mute;
    callback toggle-fullscreen;
    callback game-key(string, bool, bool, bool);

    VerticalLayout {
        padding: 10px;
        spacing: 9px;
        Rectangle {
            height: 46px;
            border-radius: 10px;
            background: #0c1b27;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;
                ActionButton { text: "Dock"; primary: true; clicked => { root.dock(); } }
                ActionButton { text: "Stop"; clicked => { root.stop-runner(); } }
                ActionButton { text: "Restart"; clicked => { root.restart-runner(); } }
                IconButton { text: root.muted ? "🔇" : "🔊"; active: root.muted; clicked => { root.toggle-mute(); } }
                ActionButton { text: root.fullscreen ? "Windowed" : "Fullscreen"; clicked => { root.toggle-fullscreen(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: root.status; color: #8ca0b0; font-size: 13px; vertical-alignment: center; }
            }
        }
        GameSurface {
            vertical-stretch: 1;
            frame: root.game-frame;
            frame-ready: root.frame-ready;
            fit-scaling: root.fit-scaling;
            frame-width: root.frame-width;
            frame-height: root.frame-height;
            status: root.status;
            game-key(text, shift, control, alt) => { root.game-key(text, shift, control, alt); }
        }
    }
}
