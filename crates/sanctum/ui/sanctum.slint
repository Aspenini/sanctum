import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";

export struct GameItem {
    id: string,
    title: string,
    path: string,
    cover: image,
    has-cover: bool,
    missing: bool,
    needs-entrypoint: bool,
}

export struct ChoiceItem {
    path: string,
}

export struct MenuItem {
    label: string,
    command: string,
    enabled: bool,
}

export struct OverlayItem {
    id: string,
    kind: string,
    label: string,
    x: float,
    y: float,
    w: float,
    h: float,
}

export struct BindChoice {
    id: string,
    label: string,
}

component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <length> button-height: 36px;
    in property <length> text-size: 14px;
    callback clicked;

    height: root.button-height;
    min-width: 80px;
    border-radius: 4px;
    background: !root.enabled ? #242424 : touch.pressed ? #4a4a4a : touch.has-hover ? #3b3b3b : root.primary ? #e0e0e0 : #303030;
    border-width: root.primary ? 0px : 1px;
    border-color: #464646;

    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: !root.enabled ? #686868 : root.primary ? #151515 : #ededed;
        font-size: root.text-size;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ToolButton inherits Rectangle {
    in property <Icon> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;

    width: 38px;
    height: 38px;
    border-radius: 4px;
    background: !root.enabled ? transparent : touch.pressed ? #494949 : touch.has-hover ? #383838 : root.active ? #444444 : transparent;

    IconDisplay {
        icon: root.icon;
        size: 20px;
        stroke: root.enabled ? #eeeeee : #676767;
        stroke-width: 1.8;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SideButton inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 64px;
    border-radius: 5px;
    background: touch.pressed ? #555555 : touch.has-hover ? #353535 : root.active ? #d7d7d7 : transparent;

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 6px;
        spacing: 1px;
        Rectangle {
            height: 28px;
            background: transparent;
            IconDisplay {
                icon: root.icon;
                size: 22px;
                stroke: root.active ? #171717 : #eeeeee;
                stroke-width: 1.8;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        Text {
            text: root.label;
            color: root.active ? #171717 : #a8a8a8;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BottomButton inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    horizontal-stretch: 1;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? #e4e4e4 : touch.pressed ? #3a3a3a : touch.has-hover ? #2e2e2e : transparent;

                IconDisplay {
                    icon: root.icon;
                    size: 20px;
                    stroke: root.active ? #171717 : #eeeeee;
                    stroke-width: 1.8;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        Text {
            text: root.label;
            color: root.active ? #f4f4f4 : #a8a8a8;
            font-size: 11px;
            font-weight: root.active ? 600 : 400;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SelectButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;

    height: 30px;
    min-width: 70px;
    border-radius: 3px;
    background: root.active ? #e0e0e0 : touch.has-hover ? #393939 : transparent;

    Text {
        text: root.text;
        color: root.active ? #171717 : #a7a7a7;
        font-size: 12px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}

component PageTitle inherits Text {
    color: #f2f2f2;
    font-size: 25px;
    font-weight: 500;
    vertical-alignment: center;
}

component GameTile inherits Rectangle {
    in property <GameItem> game;
    callback launch;
    callback options;

    border-radius: 5px;
    clip: true;
    background: #292929;
    border-width: 1px;
    border-color: root.game.missing ? #875050 : tile-touch.has-hover ? #9a9a9a : #3b3b3b;

    if root.game.has-cover : Image {
        source: root.game.cover;
        image-fit: cover;
        image-rendering: pixelated;
    }

    if !root.game.has-cover : Rectangle {
        background: #303030;
        Text {
            text: "HC";
            color: #a8a8a8;
            font-size: 36px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if tile-touch.has-hover : Rectangle {
        background: #ffffff12;
    }

    Rectangle {
        y: parent.height - 43px;
        height: 43px;
        background: #101010dc;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 4px;
            Text {
                text: root.game.title;
                color: #ffffff;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }

    if root.game.missing : Rectangle {
        background: #151515aa;
        Text {
            text: "Entrypoint missing";
            color: #ffb4b4;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    tile-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (!root.game.missing) {
                root.launch();
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.options();
            }
        }
    }

    ToolButton {
        x: parent.width - 40px;
        y: parent.height - 40px;
        icon: IconSet.EllipsisVertical;
        clicked => { root.options(); }
    }
}

component GameSurface inherits Rectangle {
    in property <image> frame;
    in property <bool> frame-ready: false;
    in property <bool> fit-scaling: false;
    in property <int> frame-width: 640;
    in property <int> frame-height: 480;
    in property <string> status;
    property <float> available-scale: Math.min(self.width / (root.frame-width * 1px), self.height / (root.frame-height * 1px));
    property <float> draw-scale: root.fit-scaling ? root.available-scale : Math.max(1, Math.floor(root.available-scale));
    callback game-key(string, bool, bool, bool);
    callback game-pointer(int, int, bool, bool);

    background: #000000;
    clip: true;
    forward-focus: game-focus;
    property <bool> pointer-left: false;
    property <bool> pointer-right: false;

    if root.frame-ready : Image {
        source: root.frame;
        image-fit: fill;
        image-rendering: pixelated;
        width: root.frame-width * 1px * root.draw-scale;
        height: root.frame-height * 1px * root.draw-scale;
    }

    if !root.frame-ready : VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text { text: "Sanctum"; color: #e5e5e5; font-size: 22px; horizontal-alignment: center; }
        Text { text: root.status; color: #888888; font-size: 13px; horizontal-alignment: center; }
    }

    game-focus := FocusScope {
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            root.game-key(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
            accept
        }
    }

    pointer := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) { root.pointer-left = true; }
                if (event.kind == PointerEventKind.up) { root.pointer-left = false; }
            }
            if (event.button == PointerEventButton.right) {
                if (event.kind == PointerEventKind.down) { root.pointer-right = true; }
                if (event.kind == PointerEventKind.up) { root.pointer-right = false; }
            }
            root.emit-pointer();
        }
        moved => { root.emit-pointer(); }
    }

    function emit-pointer() {
        root.game-pointer(
            Math.max(0, Math.min(root.frame-width - 1, Math.floor(pointer.mouse-x / 1px / Math.max(root.draw-scale, 0.001)))),
            Math.max(0, Math.min(root.frame-height - 1, Math.floor(pointer.mouse-y / 1px / Math.max(root.draw-scale, 0.001)))),
            root.pointer-left,
            root.pointer-right
        );
    }
}

component OverlayWidget inherits Rectangle {
    in property <OverlayItem> item;
    in property <bool> editing: false;
    in property <bool> selected: false;
    in property <length> pad-width;
    in property <length> pad-height;
    callback pressed(float, float);
    callback released;
    callback moved(float, float);
    callback dragged(float, float);

    border-radius: root.item.kind == "dpad" || root.item.kind == "stick" || root.item.kind == "mouse" ? self.width / 2 : 18px;
    background: touch.pressed ? #e8e8e8cc : root.selected ? #d0d0d0aa : #2a2a2acc;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? #ffffff : #5a5a5a;
    property <length> grab-x: 0px;
    property <length> grab-y: 0px;

    Text {
        text: root.item.label;
        color: touch.pressed ? #111111 : #f2f2f2;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.grab-x = self.mouse-x;
                root.grab-y = self.mouse-y;
                if (!root.editing) {
                    root.pressed(
                        Math.max(0, Math.min(1, self.mouse-x / Math.max(parent.width, 1px))),
                        Math.max(0, Math.min(1, self.mouse-y / Math.max(parent.height, 1px)))
                    );
                }
            }
            if (event.kind == PointerEventKind.up && !root.editing) {
                root.released();
            }
        }
        moved => {
            if (root.editing) {
                root.dragged(
                    (root.x + touch.mouse-x - root.grab-x) / Math.max(root.pad-width, 1px),
                    (root.y + touch.mouse-y - root.grab-y) / Math.max(root.pad-height, 1px)
                );
            } else {
                root.moved(
                    Math.max(0, Math.min(1, touch.mouse-x / Math.max(parent.width, 1px))),
                    Math.max(0, Math.min(1, touch.mouse-y / Math.max(parent.height, 1px)))
                );
            }
        }
        clicked => {
            if (root.editing) {
                root.pressed(0.5, 0.5);
            }
        }
    }
}

component OnScreenPad inherits Rectangle {
    in property <[OverlayItem]> items;
    in property <bool> editing: false;
    in property <bool> overlay-style: false;
    in property <string> selected-id;
    callback pressed(string, float, float);
    callback released(string);
    callback moved(string, float, float);
    callback dragged(string, float, float);
    callback selected(string);

    background: root.overlay-style ? transparent : #101010;
    clip: true;

    for item in root.items : OverlayWidget {
        x: item.x * parent.width;
        y: item.y * parent.height;
        width: Math.max(item.w * parent.width, 48px);
        height: Math.max(item.h * parent.height, 48px);
        item: item;
        editing: root.editing;
        selected: root.selected-id == item.id;
        pad-width: parent.width;
        pad-height: parent.height;
        pressed(nx, ny) => {
            root.selected(item.id);
            root.pressed(item.id, nx, ny);
        }
        released => { root.released(item.id); }
        moved(nx, ny) => { root.moved(item.id, nx, ny); }
        dragged(nx, ny) => { root.dragged(item.id, nx, ny); }
    }
}

export component MainWindow inherits Window {
    title: "Sanctum";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 320px;
    min-height: 480px;
    background: #1b1b1b;

    in property <[GameItem]> games;
    in property <[ChoiceItem]> entry-choices;
    in property <[MenuItem]> menu-items;
    in property <image> game-frame;
    in property <bool> frame-ready: false;
    in property <int> frame-width: 640;
    in property <int> frame-height: 480;
    in property <bool> running: false;
    in property <bool> detached: false;
    in property <bool> muted: false;
    in property <bool> fullscreen: false;
    in property <bool> log-open: false;
    in property <bool> settings-open: false;
    in property <bool> details-open: false;
    in property <bool> choices-open: false;
    in property <bool> storage-confirm-open: false;
    in property <int> sort-index: 0;
    in property <string> status: "Ready";
    in property <string> program-log;
    in property <string> selected-title;
    in property <string> selected-path;
    in property <string> data-path;
    in property <string> templeos-path;
    in property <string> storage-label;
    in property <string> storage-action;
    in property <bool> portable-available: true;
    in property <bool> fit-scaling: false;
    in property <bool> desktop-chrome: true;
    in property <bool> compact-layout: false;
    in property <bool> landscape: false;
    in property <bool> overlay-enabled: false;
    in property <bool> controls-editor-open: false;
    in property <bool> bind-open: false;
    in property <[OverlayItem]> overlay-items;
    in property <[BindChoice]> bind-choices;
    in property <[BindChoice]> preset-choices;
    in property <[BindChoice]> gamepad-choices;
    in property <string> overlay-selected;
    in property <string> active-preset;
    in property <string> preset-name-edit;
    in property <string> bind-title;
    in property <string> capture-hint;
    property <bool> split-controls: root.overlay-enabled && !root.landscape && root.running && (!root.detached || !root.desktop-chrome);
    property <length> sidebar-width: 88px;
    property <length> nav-gutter: root.compact-layout ? 0px : root.sidebar-width;
    property <length> bottom-bar-height: 64px;
    property <bool> show-bottom-bar: root.compact-layout && !root.running;
    property <length> content-padding: root.compact-layout ? 16px : 26px;
    property <length> tile-gap: root.compact-layout ? 12px : 16px;
    property <length> content-width: root.width - root.safe-area-insets.left - root.safe-area-insets.right - root.nav-gutter;
    property <int> tile-columns: root.content-width >= 1720px ? 6 : root.content-width >= 1440px ? 5 : root.content-width >= 1120px ? 4 : root.content-width >= 850px ? 3 : root.content-width >= 560px ? 2 : 1;
    property <length> tile-area-width: max(root.content-width - root.content-padding * 2, 1px);
    property <length> tile-width: (root.tile-area-width - (root.tile-columns - 1) * root.tile-gap) / root.tile-columns;
    property <length> tile-height: root.tile-width * 0.75;
    property <length> dialog-width: min(520px, root.width - 24px);
    property <length> dialog-max-height: min(520px, root.height - 24px);

    callback add-library;
    callback run-file;
    callback search-changed(string);
    callback set-sort(int);
    callback select-game(string);
    callback run-game(string);
    callback close-details;
    callback save-title(string);
    callback choose-entrypoint;
    callback choose-cover;
    callback remove-selected;
    callback run-selected;
    callback choose-entry(string);
    callback cancel-choices;
    callback show-settings;
    callback close-settings;
    callback choose-templeos;
    callback set-scaling(bool);
    callback request-storage-change;
    callback cancel-storage-change;
    callback confirm-storage-change;
    callback show-library;
    callback stop-runner;
    callback restart-runner;
    callback toggle-mute;
    callback toggle-fullscreen;
    callback toggle-detached;
    callback toggle-log;
    callback invoke-menu(string);
    callback game-key(string, bool, bool, bool);
    callback game-pointer(int, int, bool, bool);
    callback toggle-overlay;
    callback overlay-pressed(string, float, float);
    callback overlay-released(string);
    callback overlay-moved(string, float, float);
    callback overlay-dragged(string, float, float);
    callback select-overlay(string);
    callback open-controls-editor;
    callback close-controls-editor;
    callback select-preset(string);
    callback save-preset;
    callback new-preset;
    callback delete-preset;
    callback reset-preset;
    callback preset-name-changed(string);
    callback open-bind(string);
    callback close-bind;
    callback choose-bind(string);

    VerticalLayout {
        padding-top: root.safe-area-insets.top;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        padding-bottom: root.show-bottom-bar ? 0px : root.safe-area-insets.bottom;
        spacing: 0px;

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            if !root.compact-layout : Rectangle {
                width: root.sidebar-width;
                background: #171717;
                border-width: 0px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    alignment: center;

                    SideButton { icon: IconSet.Library; label: "Library"; active: !root.running && !root.settings-open; clicked => { root.close-settings(); root.show-library(); } }
                    SideButton { icon: IconSet.FilePlay; label: "Run"; clicked => { root.close-settings(); root.run-file(); } }
                    SideButton { icon: IconSet.Plus; label: "Add"; clicked => { root.close-settings(); root.add-library(); } }
                    SideButton { icon: IconSet.Settings; label: "Settings"; active: root.settings-open; clicked => { root.show-settings(); } }
                }
            }

            if !root.running : Rectangle {
                background: #1d1d1d;

                VerticalLayout {
                    padding: root.content-padding;
                    spacing: root.compact-layout ? 12px : 16px;

                    if !root.compact-layout : HorizontalLayout {
                        height: 42px;
                        spacing: 10px;
                        PageTitle { text: "Library"; horizontal-stretch: 1; }
                        LineEdit {
                            width: 250px;
                            placeholder-text: "Search";
                            input-type: search;
                            edited(value) => { root.search-changed(value); }
                        }
                    }

                    if root.compact-layout : VerticalLayout {
                        spacing: 10px;
                        PageTitle { text: "Library"; }
                        LineEdit {
                            placeholder-text: "Search";
                            input-type: search;
                            edited(value) => { root.search-changed(value); }
                        }
                    }

                    HorizontalLayout {
                        height: 30px;
                        spacing: 4px;
                        if !root.compact-layout : Text { text: root.games.length + (root.games.length == 1 ? " program" : " programs"); color: #858585; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                        if root.compact-layout : Rectangle { horizontal-stretch: 1; background: transparent; }
                        if !root.compact-layout : Text { text: "Sort"; color: #777777; font-size: 12px; vertical-alignment: center; }
                        SelectButton { text: "Title"; active: root.sort-index == 0; clicked => { root.set-sort(0); } }
                        SelectButton { text: "Recent"; active: root.sort-index == 1; clicked => { root.set-sort(1); } }
                        SelectButton { text: "Added"; active: root.sort-index == 2; clicked => { root.set-sort(2); } }
                    }

                    if root.compact-layout : Text { text: root.games.length + (root.games.length == 1 ? " program" : " programs"); color: #858585; font-size: 12px; height: 16px; vertical-alignment: center; }

                if root.games.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        Text { text: "No programs"; color: #ededed; font-size: 20px; horizontal-alignment: center; }
                        Text { text: "Choose a folder containing HolyC programs to get started."; color: #888888; font-size: 13px; horizontal-alignment: center; }
                        FlatButton { width: 184px; text: "Choose library folder"; primary: true; clicked => { root.add-library(); } }
                    }
                }

                if root.games.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: Math.ceil(root.games.length / root.tile-columns) * (root.tile-height + root.tile-gap);

                    for game[index] in root.games : GameTile {
                        x: Math.mod(index, root.tile-columns) * (root.tile-width + root.tile-gap);
                        y: Math.floor(index / root.tile-columns) * (root.tile-height + root.tile-gap);
                        width: root.tile-width;
                        height: root.tile-height;
                        game: game;
                        launch => { root.run-game(game.id); }
                        options => { root.select-game(game.id); }
                    }
                }

                Text { text: root.status; color: #777777; font-size: 11px; height: 16px; vertical-alignment: center; overflow: elide; }
            }
            }

            if root.running : Rectangle {
            background: #1d1d1d;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Rectangle {
                    height: 44px;
                    background: #252525;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 7px;
                        alignment: center;
                        ToolButton { icon: IconSet.Library; clicked => { root.show-library(); } }
                        ToolButton { icon: IconSet.CircleStop; clicked => { root.stop-runner(); } }
                        ToolButton { icon: IconSet.RotateCcw; clicked => { root.restart-runner(); } }
                        ToolButton { icon: root.muted ? IconSet.VolumeX : IconSet.Volume2; active: root.muted; clicked => { root.toggle-mute(); } }
                        if root.desktop-chrome : ToolButton { icon: root.fullscreen ? IconSet.Minimize : IconSet.Maximize; active: root.fullscreen; clicked => { root.toggle-fullscreen(); } }
                        if root.desktop-chrome : ToolButton { icon: root.detached ? IconSet.Dock : IconSet.PictureInPicture2; active: root.detached; clicked => { root.toggle-detached(); } }
                        ToolButton { icon: IconSet.Gamepad2; active: root.overlay-enabled; clicked => { root.toggle-overlay(); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: root.status; color: #9a9a9a; font-size: 12px; vertical-alignment: center; overflow: elide; }
                        ToolButton { icon: IconSet.Menu; active: root.log-open; clicked => { root.toggle-log(); } }
                    }
                }

                if root.menu-items.length > 0 : Flickable {
                    height: 34px;
                    viewport-width: root.menu-items.length * 120px;
                    viewport-height: self.height;
                    for menu[index] in root.menu-items : FlatButton {
                        x: index * 120px;
                        width: 114px;
                        text: menu.label;
                        text-size: 12px;
                        enabled: menu.enabled;
                        button-height: 32px;
                        clicked => { root.invoke-menu(menu.command); }
                    }
                }

                if !root.detached || !root.desktop-chrome : Rectangle {
                    vertical-stretch: 1;
                    background: #000000;

                    if root.split-controls : VerticalLayout {
                        spacing: 0px;
                        GameSurface {
                            vertical-stretch: 1;
                            frame: root.game-frame;
                            frame-ready: root.frame-ready;
                            fit-scaling: root.fit-scaling;
                            frame-width: root.frame-width;
                            frame-height: root.frame-height;
                            status: root.status;
                            game-key(text, shift, control, alt) => { root.game-key(text, shift, control, alt); }
                            game-pointer(x, y, left, right) => { root.game-pointer(x, y, left, right); }
                        }
                        OnScreenPad {
                            vertical-stretch: 1;
                            min-height: 160px;
                            items: root.overlay-items;
                            overlay-style: false;
                            selected-id: root.overlay-selected;
                            pressed(id, nx, ny) => { root.overlay-pressed(id, nx, ny); }
                            released(id) => { root.overlay-released(id); }
                            moved(id, nx, ny) => { root.overlay-moved(id, nx, ny); }
                            dragged(id, nx, ny) => { root.overlay-dragged(id, nx, ny); }
                            selected(id) => { root.select-overlay(id); }
                        }
                    }

                    if !root.split-controls : GameSurface {
                        width: parent.width;
                        height: parent.height;
                        frame: root.game-frame;
                        frame-ready: root.frame-ready;
                        fit-scaling: root.fit-scaling;
                        frame-width: root.frame-width;
                        frame-height: root.frame-height;
                        status: root.status;
                        game-key(text, shift, control, alt) => { root.game-key(text, shift, control, alt); }
                        game-pointer(x, y, left, right) => { root.game-pointer(x, y, left, right); }
                    }

                    if !root.split-controls && root.overlay-enabled : OnScreenPad {
                        width: parent.width;
                        height: parent.height;
                        items: root.overlay-items;
                        overlay-style: true;
                        selected-id: root.overlay-selected;
                        pressed(id, nx, ny) => { root.overlay-pressed(id, nx, ny); }
                        released(id) => { root.overlay-released(id); }
                        moved(id, nx, ny) => { root.overlay-moved(id, nx, ny); }
                        dragged(id, nx, ny) => { root.overlay-dragged(id, nx, ny); }
                        selected(id) => { root.select-overlay(id); }
                    }
                }

                if root.detached && root.desktop-chrome : Rectangle {
                    vertical-stretch: 1;
                    background: #222222;
                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        Text { text: "Game is open in a separate window"; color: #eeeeee; font-size: 18px; horizontal-alignment: center; }
                        Text { text: "Input, audio, saves, and the runner remain connected."; color: #858585; font-size: 13px; horizontal-alignment: center; }
                        FlatButton { text: "Dock game"; primary: true; clicked => { root.toggle-detached(); } }
                    }
                }

                if root.log-open : Rectangle {
                    height: root.compact-layout ? 120px : 150px;
                    background: #111111;
                    border-width: 1px;
                    border-color: #383838;
                    ScrollView {
                        Text {
                            width: parent.width;
                            text: root.program-log;
                            color: #b0b0b0;
                            font-family: "monospace";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            }
        }

        if root.show-bottom-bar : Rectangle {
            height: root.bottom-bar-height + root.safe-area-insets.bottom;
            background: #141414;

            VerticalLayout {
                spacing: 0px;
                Rectangle { height: 1px; background: #2c2c2c; }
                HorizontalLayout {
                    height: root.bottom-bar-height;
                    padding-left: 4px;
                    padding-right: 4px;
                    BottomButton { icon: IconSet.Library; label: "Library"; active: !root.settings-open; clicked => { root.close-settings(); root.show-library(); } }
                    BottomButton { icon: IconSet.FilePlay; label: "Run"; clicked => { root.close-settings(); root.run-file(); } }
                    BottomButton { icon: IconSet.Plus; label: "Add"; clicked => { root.close-settings(); root.add-library(); } }
                    BottomButton { icon: IconSet.Settings; label: "Settings"; active: root.settings-open; clicked => { root.show-settings(); } }
                }
                Rectangle { height: root.safe-area-insets.bottom; background: #141414; }
            }
        }
    }

    if root.details-open : Rectangle {
        background: #00000099;
        TouchArea { }
        Rectangle {
            width: root.dialog-width;
            height: min(382px, root.dialog-max-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: #242424;
            border-width: 1px;
            border-color: #484848;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    PageTitle { text: "Program options"; horizontal-stretch: 1; font-size: 21px; }
                    ToolButton { icon: IconSet.X; clicked => { root.close-details(); } }
                }
                Text { text: "Title"; color: #aaaaaa; font-size: 12px; }
                LineEdit { text: root.selected-title; edited(value) => { root.save-title(value); } }
                Text { text: "Entrypoint"; color: #aaaaaa; font-size: 12px; }
                Text { text: root.selected-path; color: #d0d0d0; font-size: 12px; overflow: elide; }
                HorizontalLayout {
                    spacing: 8px;
                    FlatButton { width: 112px; text: "Entrypoint"; clicked => { root.choose-entrypoint(); } }
                    FlatButton { width: 120px; text: "Cover image"; clicked => { root.choose-cover(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 8px;
                    FlatButton { width: 178px; text: "Remove from library"; clicked => { root.remove-selected(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlatButton { text: "Run"; primary: true; clicked => { root.run-selected(); } }
                }
            }
        }
    }

    if root.settings-open : Rectangle {
        x: root.safe-area-insets.left + root.nav-gutter;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right - root.nav-gutter;
        height: root.height - root.safe-area-insets.top - (root.show-bottom-bar ? root.bottom-bar-height + root.safe-area-insets.bottom : root.safe-area-insets.bottom);
        background: #1d1d1d;
        TouchArea { }

        VerticalLayout {
            padding: root.compact-layout ? 18px : 28px;
            spacing: root.compact-layout ? 16px : 24px;

            HorizontalLayout {
                height: 40px;
                PageTitle { text: "Settings"; horizontal-stretch: 1; }
                ToolButton { icon: IconSet.X; clicked => { root.close-settings(); } }
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;

                VerticalLayout {
                    width: min(680px, root.content-width - (root.compact-layout ? 36px : 56px));
                    spacing: 14px;

                    Text { text: "Game"; color: #f0f0f0; font-size: 16px; font-weight: 600; }
                    if !root.compact-layout : HorizontalLayout {
                        height: 36px;
                        Text { text: "Canvas scaling"; color: #dddddd; font-size: 13px; vertical-alignment: center; width: 180px; }
                        SelectButton { text: "Integer"; active: !root.fit-scaling; clicked => { root.set-scaling(false); } }
                        SelectButton { text: "Fit window"; active: root.fit-scaling; clicked => { root.set-scaling(true); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    if root.compact-layout : VerticalLayout {
                        spacing: 8px;
                        Text { text: "Canvas scaling"; color: #dddddd; font-size: 13px; }
                        HorizontalLayout {
                            height: 36px;
                            spacing: 4px;
                            SelectButton { text: "Integer"; active: !root.fit-scaling; clicked => { root.set-scaling(false); } }
                            SelectButton { text: "Fit"; active: root.fit-scaling; clicked => { root.set-scaling(true); } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }

                    Rectangle { height: 18px; background: transparent; }
                    Text { text: "TempleOS files"; color: #f0f0f0; font-size: 16px; font-weight: 600; }
                    Text { text: root.templeos-path; color: #999999; font-size: 12px; overflow: elide; wrap: word-wrap; }
                    HorizontalLayout {
                        FlatButton { min-width: 180px; text: "Choose extracted TempleOS folder"; clicked => { root.choose-templeos(); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }

                    Rectangle { height: 18px; background: transparent; }
                    Text { text: "Storage"; color: #f0f0f0; font-size: 16px; font-weight: 600; }
                    Text { text: root.storage-label; color: #d0d0d0; font-size: 12px; }
                    Text { text: root.data-path; color: #8f8f8f; font-size: 12px; overflow: elide; wrap: word-wrap; }
                    if root.desktop-chrome : HorizontalLayout {
                        FlatButton { width: 220px; text: root.storage-action; enabled: root.portable-available; clicked => { root.request-storage-change(); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    if root.desktop-chrome && !root.portable-available : Text {
                        text: "Portable mode is unavailable because the executable folder is not writable.";
                        color: #d8a47d;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if !root.desktop-chrome : Text {
                        text: "On Android, Sanctum always uses app storage. Portable mode is a desktop feature.";
                        color: #858585;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Text { text: "Imported projects always remain in their original folders."; color: #858585; font-size: 12px; wrap: word-wrap; }

                    Rectangle { height: 18px; background: transparent; }
                    Text { text: "Controls"; color: #f0f0f0; font-size: 16px; font-weight: 600; }
                    Text { text: "On-screen controls and controller bindings share the same presets."; color: #858585; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        height: 36px;
                        Text { text: "On-screen pad"; color: #dddddd; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                        SelectButton { text: "On"; active: root.overlay-enabled; clicked => { if (!root.overlay-enabled) { root.toggle-overlay(); } } }
                        SelectButton { text: "Off"; active: !root.overlay-enabled; clicked => { if (root.overlay-enabled) { root.toggle-overlay(); } } }
                    }
                    Text { text: "Preset"; color: #aaaaaa; font-size: 12px; }
                    Flickable {
                        height: 36px;
                        viewport-height: self.height;
                        viewport-width: Math.max(root.preset-choices.length * 110px, self.width);
                        for preset[index] in root.preset-choices : SelectButton {
                            x: index * 110px;
                            width: 104px;
                            text: preset.label;
                            active: preset.id == root.active-preset;
                            clicked => { root.select-preset(preset.id); }
                        }
                    }
                    Text { text: "Preset name"; color: #aaaaaa; font-size: 12px; }
                    LineEdit { text: root.preset-name-edit; edited(value) => { root.preset-name-changed(value); } }
                    HorizontalLayout {
                        spacing: 8px;
                        FlatButton { text: "Save"; clicked => { root.save-preset(); } }
                        FlatButton { text: "Save as new"; clicked => { root.new-preset(); } }
                        FlatButton { text: "Delete"; clicked => { root.delete-preset(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        FlatButton { text: "Edit layout"; primary: true; clicked => { root.open-controls-editor(); } }
                        FlatButton { text: "Reset layout"; clicked => { root.reset-preset(); } }
                    }
                    Text { text: "Controller"; color: #aaaaaa; font-size: 12px; }
                    Text { text: "Tap a binding, then choose a TempleOS key. Connected controllers use this map immediately."; color: #858585; font-size: 12px; wrap: word-wrap; }
                    for pad in root.gamepad-choices : HorizontalLayout {
                        height: 34px;
                        spacing: 8px;
                        Text { text: pad.label; color: #d0d0d0; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        FlatButton { text: "Bind"; clicked => { root.open-bind(pad.id); } }
                    }
                }
            }
        }
    }

    if root.choices-open : Rectangle {
        background: #000000aa;
        TouchArea { }
        Rectangle {
            width: min(560px, root.width - 24px);
            height: min(480px, root.height - 24px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: #242424;
            border-width: 1px;
            border-color: #484848;
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    PageTitle { text: "Choose an entrypoint"; horizontal-stretch: 1; font-size: 21px; }
                    ToolButton { icon: IconSet.X; clicked => { root.cancel-choices(); } }
                }
                Text { text: "Select the .HC file Sanctum should launch."; color: #999999; font-size: 13px; }
                ListView {
                    vertical-stretch: 1;
                    for choice in root.entry-choices : FlatButton {
                        width: parent.width;
                        text: choice.path;
                        clicked => { root.choose-entry(choice.path); }
                    }
                }
            }
        }
    }

    if root.storage-confirm-open && root.desktop-chrome : Rectangle {
        background: #000000bb;
        TouchArea { }
        Rectangle {
            width: min(510px, root.width - 24px);
            height: min(245px, root.height - 24px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: #242424;
            border-width: 1px;
            border-color: #484848;
            VerticalLayout {
                padding: 22px;
                spacing: 13px;
                PageTitle { text: "Move Sanctum data?"; font-size: 21px; }
                Text {
                    text: "Settings, covers, and compatibility saves will be staged, verified, and moved. Imported projects and your TempleOS folder stay where they are.";
                    color: #b6b6b6;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlatButton { text: "Cancel"; clicked => { root.cancel-storage-change(); } }
                    FlatButton { text: "Move and restart"; primary: true; clicked => { root.confirm-storage-change(); } }
                }
            }
        }
    }

    if root.controls-editor-open : Rectangle {
        background: #111111;
        TouchArea { }

        VerticalLayout {
            padding-top: root.safe-area-insets.top + 8px;
            padding-left: 10px;
            padding-right: 10px;
            padding-bottom: root.safe-area-insets.bottom + 8px;
            spacing: 8px;

            HorizontalLayout {
                height: 40px;
                spacing: 8px;
                PageTitle { text: "Edit controls"; font-size: 20px; horizontal-stretch: 1; }
                FlatButton { text: "Bind"; enabled: root.overlay-selected != ""; clicked => { root.open-bind("overlay:" + root.overlay-selected); } }
                ToolButton { icon: IconSet.X; clicked => { root.close-controls-editor(); } }
            }
            Text {
                text: root.landscape ? "Landscape overlay — drag to rearrange, then Bind." : "Portrait pad — drag to rearrange, then Bind.";
                color: #8f8f8f;
                font-size: 12px;
            }

            if !root.landscape : VerticalLayout {
                vertical-stretch: 1;
                spacing: 0px;
                Rectangle {
                    vertical-stretch: 1;
                    background: #000000;
                    Text { text: "Screen"; color: #555555; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                }
                OnScreenPad {
                    vertical-stretch: 1;
                    min-height: 180px;
                    items: root.overlay-items;
                    editing: true;
                    overlay-style: false;
                    selected-id: root.overlay-selected;
                    pressed(id, nx, ny) => { root.select-overlay(id); }
                    released(id) => { }
                    moved(id, nx, ny) => { }
                    dragged(id, nx, ny) => { root.overlay-dragged(id, nx, ny); }
                    selected(id) => { root.select-overlay(id); }
                }
            }

            if root.landscape : Rectangle {
                vertical-stretch: 1;
                background: #000000;
                Text { text: "Screen"; color: #444444; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                OnScreenPad {
                    width: parent.width;
                    height: parent.height;
                    items: root.overlay-items;
                    editing: true;
                    overlay-style: true;
                    selected-id: root.overlay-selected;
                    pressed(id, nx, ny) => { root.select-overlay(id); }
                    released(id) => { }
                    moved(id, nx, ny) => { }
                    dragged(id, nx, ny) => { root.overlay-dragged(id, nx, ny); }
                    selected(id) => { root.select-overlay(id); }
                }
            }
        }
    }

    if root.bind-open : Rectangle {
        background: #000000aa;
        TouchArea { clicked => { root.close-bind(); } }
        Rectangle {
            width: min(420px, root.width - 24px);
            height: min(520px, root.height - 24px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: #242424;
            border-width: 1px;
            border-color: #484848;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    PageTitle { text: root.bind-title; horizontal-stretch: 1; font-size: 18px; }
                    ToolButton { icon: IconSet.X; clicked => { root.close-bind(); } }
                }
                Text { text: root.capture-hint; color: #9a9a9a; font-size: 12px; wrap: word-wrap; }
                ListView {
                    vertical-stretch: 1;
                    for choice in root.bind-choices : FlatButton {
                        width: parent.width;
                        text: choice.label;
                        clicked => { root.choose-bind(choice.id); }
                    }
                }
            }
        }
    }
}

export component GameWindow inherits Window {
    title: "Sanctum — Game";
    preferred-width: 960px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 480px;
    background: #181818;

    in property <image> game-frame;
    in property <bool> frame-ready: false;
    in property <bool> fit-scaling: false;
    in property <int> frame-width: 640;
    in property <int> frame-height: 480;
    in property <bool> muted: false;
    in property <bool> fullscreen: false;
    in property <string> status;
    callback dock;
    callback stop-runner;
    callback restart-runner;
    callback toggle-mute;
    callback toggle-fullscreen;
    callback game-key(string, bool, bool, bool);
    callback game-pointer(int, int, bool, bool);

    VerticalLayout {
        padding: 8px;
        spacing: 7px;
        Rectangle {
            height: 42px;
            background: #252525;
            border-radius: 4px;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 7px;
                alignment: center;
                ToolButton { icon: IconSet.Dock; clicked => { root.dock(); } }
                ToolButton { icon: IconSet.CircleStop; clicked => { root.stop-runner(); } }
                ToolButton { icon: IconSet.RotateCcw; clicked => { root.restart-runner(); } }
                ToolButton { icon: root.muted ? IconSet.VolumeX : IconSet.Volume2; active: root.muted; clicked => { root.toggle-mute(); } }
                ToolButton { icon: root.fullscreen ? IconSet.Minimize : IconSet.Maximize; active: root.fullscreen; clicked => { root.toggle-fullscreen(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: root.status; color: #999999; font-size: 12px; vertical-alignment: center; }
            }
        }
        GameSurface {
            vertical-stretch: 1;
            frame: root.game-frame;
            frame-ready: root.frame-ready;
            fit-scaling: root.fit-scaling;
            frame-width: root.frame-width;
            frame-height: root.frame-height;
            status: root.status;
            game-key(text, shift, control, alt) => { root.game-key(text, shift, control, alt); }
            game-pointer(x, y, left, right) => { root.game-pointer(x, y, left, right); }
        }
    }
}
